{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": false,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@protodriver/contracts": ["../contracts/src/index.ts"],
      "@protodriver/core/*": ["../core/src/*.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
